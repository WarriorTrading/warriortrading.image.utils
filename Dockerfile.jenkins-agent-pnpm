FROM node:20-bullseye-slim

# copy scripts
RUN mkdir /scripts 
COPY ./scripts/* /scripts/

# Install required packages
RUN apt-get update && \
    apt-get install -y \
    curl \
    git \
    jq \
    python3 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm globally
RUN npm install -g pnpm@8

# Set up node user
ENV SHELL=/bin/bash
USER node
WORKDIR /home/node/agent

# Add pnpm to PATH
ENV PATH="/home/node/.local/share/pnpm:${PATH}"

# Verify installations
RUN node --version && \
    pnpm --version

